{
  "expo": {
    "name": "Ninja PRM",
    "slug": "ninja-prm-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "ninjaprm",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.adviceninja.ninjaprm",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.adviceninja.ninjaprm",
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "backgroundColor": "#ff8900"
      }
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/images/logo.png",
          "backgroundColor": "#ff8900",
          "imageWidth": 200,
          "resizeMode": "contain",
          "dark": {
            "image": "./src/assets/images/logo.png",
            "backgroundColor": "#ff8900"
          }
        }
      ],
      "expo-web-browser",
      "expo-secure-store",
      "expo-audio",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "84245266-ff07-459a-93e8-51d833f5d9cd"
      }
    }
  }
}
