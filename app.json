{
  "expo": {
    "name": "Ninja PRM",
    "slug": "ninja-prm-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "ninjaprm",
    "userInterfaceStyle": "automatic",
    "icon": "./src/assets/images/icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.adviceninja.ninjaprm",
      "icon": "./src/assets/images/icon.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.adviceninja.ninjaprm",
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/images/adaptive-icon.png",
        "backgroundColor": "#ff8900"
      }
    },
    "web": {
      "output": "static",
      "favicon": "./src/assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/images/splash-icon.png",
          "backgroundColor": "#ff8900",
          "imageWidth": 180,
          "resizeMode": "contain",
          "dark": {
            "image": "./src/assets/images/splash-icon.png",
            "backgroundColor": "#ff8900"
          }
        }
      ],
      "expo-web-browser",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": true
        }
      ],
      "expo-asset",
      "expo-sharing",
      [
        "expo-notifications",
        {
          "icon": "./src/assets/images/notification-icon.png",
          "color": "#ff8900",
          "sounds": [
            "./src/assets/sounds/classic_alert.wav",
            "./src/assets/sounds/classic_button.wav",
            "./src/assets/sounds/classic_car_beep.wav",
            "./src/assets/sounds/classic_cartoon.wav",
            "./src/assets/sounds/classic_corporate.wav",
            "./src/assets/sounds/classic_plane_chime.wav",
            "./src/assets/sounds/classic_ui_ping.wav",
            "./src/assets/sounds/classic_warning.wav",
            "./src/assets/sounds/classic_warning_2.wav",
            "./src/assets/sounds/themed_r2d2_squeaks_2.wav",
            "./src/assets/sounds/themed_r2d2_squeaks_3.wav",
            "./src/assets/sounds/themed_r2d2_squeaks_5.wav",
            "./src/assets/sounds/themed_r2d2_whistle_1.wav",
            "./src/assets/sounds/themed_r2d2_whistle_2.wav",
            "./src/assets/sounds/themed_saber_off.wav",
            "./src/assets/sounds/themed_saber_on.wav"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "84245266-ff07-459a-93e8-51d833f5d9cd"
      }
    }
  }
}
