# @better-auth/expo@1.4.3 declares `peerOptional expo-network@^8.0.7`, a range
# written before Expo renumbered its packages to match the SDK major. SDK 57
# ships expo-network@57.x, so npm's strict peer resolution refuses to install —
# even though the only API better-auth uses, addNetworkStateListener, is
# present and unchanged (verified 2026-09-23).
#
# Without this, a plain `npm install` on a clean clone fails with ERESOLVE.
# Revisit when @better-auth/expo widens the range.
legacy-peer-deps=true
