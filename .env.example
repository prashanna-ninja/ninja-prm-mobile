# Copy to `.env` and fill in. Restart Metro with cache cleared: npx expo start -c
#
# The PRM backend. MUST:
#   - equal the server's NEXT_PUBLIC_APP_URL / BETTER_AUTH_URL
#   - be HTTPS
#   - be reachable FROM THE PHONE (localhost will not work on a physical device)
#
# EXPO_PUBLIC_* values are inlined into the JS bundle at build time.
# They are NOT secret — never put an API key or signing secret here.
EXPO_PUBLIC_API_BASE_URL=https://your-prm-backend.example.com
